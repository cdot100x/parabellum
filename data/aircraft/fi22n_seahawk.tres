script = ExtResource("1")
id = "fi22n_seahawk"
display_name = "F/I-22N Seahawk"
role = "Naval Stealth Strike"
nation = "Federal Republic of Valorterra"
description = "Valorterran naval twin-seat stealth — F/I-22N Seahawk. Carrier-capable low-observable strike fighter. Fitted with MR/TRS-27A Xanadu AESA, MR/ARS-55AX RWR, and CITDS (Compatible-Integrated Tactical Defense Suite) EW/ESM.\n\nOn 27 September 1997, Valorterra's Department of Wartime Center and Office of Military Procurement selected Zenith & Roscoe Group (ZRG)'s prototype — the YF/I-22N Shark. ZRG had already won the 1993 contract to produce the F/I-22 Taima, with follow-on collaboration under New Akron Federation's F-XX effort from DTC (Defense Tinker Company) and Lawrence. NDOTunited's NSF prototype showed stronger weapon compatibility and higher speed/agility, but the YF/I-22N Shark was proven hard through carrier operations and live mock combat, and exceeded expectations as a fighter. Its public debut also showcased CITDS as next-generation self-defense, plus A2A lethality after live shoot-downs of an unmanned F-16SM test article.\n\nThe F/I-22N Seahawk has primarily served Valorterra, New Akron, Baltimore, and a wider export customer set. Its lethal A2A starter kit centers on the RP-10X Angeleye — multi-modal seekers built to deceive and defeat aircraft self-defense systems, and HOBS-compatible. RP-4C ARMS covers BVR through medium-range dogfight needs, with better fuel consumption, longer burn time, improved ergonomics, and new motor servos for mobility."
category = "fixed_wing"
manufacturer = "Zenith & Roscoe Group"
era = "Apex"
tier = "Apex"
potentiality_filled = 0
potentiality_max = 6
preview = ExtResource("4")
